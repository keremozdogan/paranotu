# ============================================================================
#  ParaNotu — ortam değişkenleri
# ============================================================================
#  Bu dosyayı `.env.local` olarak kopyala ve değerleri doldur.
#      cp .env.example .env.local
#
#  ⚠️ `.env.local` git'e GİRMEZ. Gerçek API anahtarlarını asla commit etme.
#  ⚠️ `NEXT_PUBLIC_` önekli değişkenler TARAYICIYA GÖNDERİLİR — gizli
#     anahtarları asla bu önekle tanımlama.
# ============================================================================


# ---------------------------------------------------------------- KİMLİK
# Canlı domain. Sonunda "/" OLMAYACAK.
# sitemap, canonical, RSS ve OG etiketleri bunu kullanır.
# Yayındaki değer: https://www.paranotu.com  (www'li biçim kanonik)
NEXT_PUBLIC_SITE_URL=https://www.paranotu.com

# Sahne (staging) ortamında "preview" ver → robots noindex olur,
# test içeriği Google'a düşmez.
# NEXT_PUBLIC_SITE_ENV=preview


# ------------------------------------------------------------ DOĞRULAMA
# Google Search Console meta etiketi (sadece doğrulama kodu, tam etiket değil)
NEXT_PUBLIC_GSC_VERIFICATION=

# Bing Webmaster Tools doğrulama kodu
NEXT_PUBLIC_BING_VERIFICATION=


# ------------------------------------------------------------- ANALİTİK
# G-XXXXXXXXXX biçiminde. Boş bırakılırsa script hiç yüklenmez.
NEXT_PUBLIC_GA_ID=


# --------------------------------------------------------------- REKLAM
# AdSense publisher ID — "ca-pub-XXXXXXXXXXXXXXXX"
# Slot ID'leri site.config.js → ads.slots içinde tanımlanır.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Reklam ağını tamamen kapatmak için "false".
# Boş bırakılırsa site.config.js → ads.enabled belirleyicidir.
NEXT_PUBLIC_ADS_ENABLED=

# Temsili (placeholder) reklam alanlarını göster.
#   true  → her ortamda göster (demo/sahne için)
#   false → hiç gösterme
#   boş   → geliştirmede AÇIK, production'da KAPALI  ← VARSAYILAN
NEXT_PUBLIC_AD_PLACEHOLDERS_ENABLED=

# Mobil alt yapışkan reklam. VARSAYILAN KAPALI — bilinçli.
# Ekranın altına yapışan reklam yanlış tıklamaya en çok yol açan biçimdir
# ve Google'ın "intrusive interstitial" değerlendirmesine takılabilir.
# Açmadan önce gerçekten gerekli olduğundan emin ol.
NEXT_PUBLIC_MOBILE_STICKY_AD_ENABLED=false


# ------------------------------------------------------------ .NET API
# Bülten, iletişim, yorum ve görüntülenme sayacı bu adrese gider.
# Backend kapalıyken site çalışmaya devam eder (güvenli fallback).
NEXT_PUBLIC_API_URL=http://localhost:5199


# ============================================================================
#  PİYASA VERİSİ  (src/lib/providers/market.js)
# ============================================================================
#  ⚠️ LİSANS UYARISI
#  Piyasa verisi lisanslıdır. Özellikle Borsa İstanbul eş zamanlı verisini
#  lisanssız çekmek veya yeniden dağıtmak sözleşme ihlalidir. Gecikmeli veri
#  bile çoğu zaman izne tabidir. Sağlayıcı sözleşmeni okumadan bağlama.
#
#  Bu değişkenler BOŞ bırakılırsa:
#    • production → arayüz "Veri sağlayıcısı yapılandırılmadı" yazar
#    • geliştirme → sabit örnek değerler gösterilir, "geliştirme verisi"
#      rozetiyle işaretlenir (rastgele değil, sabit — canlı sanılmasın diye)
# ============================================================================

# Adaptör kimliği. Şu an tanımlı: "rest"
MARKET_DATA_PROVIDER=

# Sağlayıcı anahtarı — GİZLİ, NEXT_PUBLIC_ ÖNEKİ KULLANMA
MARKET_DATA_API_KEY=

# REST adaptörü için taban adres. Beklenen uç nokta:
#   GET {base}/quotes?symbols=USDTRY,EURTRY
#   → { "USDTRY": { value, previousClose, updatedAt }, ... }
MARKET_DATA_BASE_URL=

# Arayüzde gösterilecek kaynak künyesi
MARKET_DATA_SOURCE_NAME=
MARKET_DATA_SOURCE_URL=
MARKET_DATA_LICENSE=

# Veri gecikmesi (dakika). Lisansın ne diyorsa onu yaz — kullanıcıya
# "15 dakika gecikmeli" olarak gösterilir. Gerçek zamanlıysa 0.
MARKET_DATA_DELAY_MINUTES=15

# Cache süresi (saniye). Gecikmeli veride sık çekmenin anlamı yok.
MARKET_DATA_REVALIDATE=60


# ============================================================================
#  HABER AKIŞI  (src/lib/providers/news.js)
# ============================================================================
#  Birincil haber kaynağı editoryal içeriktir (content/news/*.mdx).
#  Bu sağlayıcı ona EK bir akış bağlamak içindir.
#
#  ⚠️ Telif: bu katman tam metin taşımaz. Yalnızca başlık + özet + kaynak
#  bağlantısı gösterilir. Dış görseller hotlink EDİLMEZ.
# ============================================================================

NEWS_PROVIDER=
NEWS_API_KEY=
NEWS_API_BASE_URL=
NEWS_SOURCE_NAME=
NEWS_SOURCE_URL=
NEWS_LICENSE=
NEWS_REVALIDATE=300


# ============================================================================
#  EKONOMİK TAKVİM  (src/lib/providers/calendar.js)
# ============================================================================
#  Birincil kaynak elle bakımı yapılan content/data/calendar.js dosyasıdır.
#  Dış sağlayıcı isteğe bağlı zenginleştirmedir; editoryal kayıt kazanır.
# ============================================================================

CALENDAR_PROVIDER=
CALENDAR_API_KEY=
CALENDAR_API_BASE_URL=
CALENDAR_REVALIDATE=3600


# ============================================================================
#  RESMÎ KURUM BESLEMELERİ  (src/lib/providers/official.js)
# ============================================================================
#  ⚠️ Yalnızca kurumun KENDİ yayımladığı RSS/Atom beslemeleri. HTML sayfası
#  kazınmaz. Yeni bir kaynak eklemeden önce kurumun kullanım koşullarını ve
#  robots.txt dosyasını kontrol et.
#
#  Biçim:  id|görünen ad|besleme adresi
#  Kayıtlar noktalı virgülle ayrılır.
#
#  Örnek (adresleri kurumun güncel yayınından doğrula):
#  OFFICIAL_FEEDS="tcmb|TCMB Duyuruları|https://.../rss;tuik|TÜİK Bültenleri|https://.../rss"
# ============================================================================

OFFICIAL_FEEDS=
OFFICIAL_REVALIDATE=1800


# ============================================================================
#  GELİŞTİRME BAYRAKLARI
# ============================================================================
#  Production'da mock piyasa verisini AÇAR. Varsayılan: kapalı.
#  Yalnızca sahne ortamında arayüz göstermek için kullan — açıldığında bile
#  veriler "geliştirme verisi" rozetiyle işaretlenir.
#  ⚠️ GERÇEK PRODUCTION'DA ASLA "true" YAPMA.
# PARANOTU_ALLOW_MOCK_DATA=false
